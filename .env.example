# ---------------------------------------------------------------------------
# LabLink environment. Copy to .env.local and fill in. Never commit real values.
# The app runs with zero configuration: when Supabase is absent it uses the
# in-memory demo dataset (src/lib/db/store.ts) seeded with two campuses.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Set to "true" on the evaluator deployment to show one-click demo accounts.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000

# --- Supabase (optional; enables the Postgres repository adapter) -----------
# All three must be set for the adapter to be selected; otherwise the app uses
# the seeded in-memory demo store. See README "Running on Postgres".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- GenAI (optional; otherwise the solver fallback is used everywhere) -----
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Email (optional; otherwise the outbox records status "skipped") --------
# "console" writes the rendered email to the server log (local development).
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@lablink.example

# --- Demo accounts (server-side only, never NEXT_PUBLIC) --------------------
DEMO_STUDENT_EMAIL=student@demo.lablink.example
DEMO_FACULTY_EMAIL=faculty@demo.lablink.example
DEMO_ADMIN_EMAIL=admin@demo.lablink.example
DEMO_PASSWORD=
